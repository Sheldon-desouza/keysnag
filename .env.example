# vibeguard local config. Copy to .env. Never commit .env. Nothing here leaves your machine.
VG_REPO_DIR=.
VG_SITE_URL=https://your-app.vercel.app
VG_SUPABASE_URL=https://xxxx.supabase.co
VG_SUPABASE_ANON_KEY=eyJ...        # public anon key (safe to hold; used to test what an anon user can reach)
VG_PG_URL=postgres://readonly:...@db.xxxx.supabase.co:5432/postgres  # READ-ONLY role, for the RLS audit
VG_TOKEN_A=eyJ...                  # a normal signed-in user's Supabase JWT (test account A)
VG_TOKEN_B=eyJ...                  # a second user's JWT (test account B), for the cross-account test
