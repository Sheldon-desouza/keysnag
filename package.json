{
  "name": "keysnag",
  "version": "0.0.0",
  "private": true,
  "description": "Local security checks for AI-built Next.js + Supabase apps. Runs in your terminal, Claude Code, or any MCP client. Nothing leaves your machine.",
  "type": "module",
  "bin": {
    "keysnag": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "test": "node --test --import tsx tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
